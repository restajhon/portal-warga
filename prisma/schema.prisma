generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERASIONAL
}

enum AccountType {
  WARGA
  PENGURUS
}

enum UserStatus {
  MENUNGGU_VERIFIKASI
  AKTIF
  NONAKTIF
}

enum ContentType {
  BERITA
  PENGUMUMAN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum FinanceReportStatus {
  DRAFT
  MENUNGGU_APPROVAL
  DISETUJUI
  DIPUBLIKASIKAN
}

model User {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String
  email              String      @unique
  phone              String?     @unique
  passwordHash       String?     @map("password_hash")
  role               UserRole?
  accountType        AccountType @map("account_type")
  status             UserStatus  @default(MENUNGGU_VERIFIKASI)
  address            String?
  phoneVerifiedAt    DateTime?   @map("phone_verified_at")
  emailVerifiedAt    DateTime?   @map("email_verified_at")
  passwordSetAt      DateTime?   @map("password_set_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  contents           Content[]
  agendas            Agenda[]
  documents          Documentation[]
  programUpdates     ProgramUpdate[]
  transactions       FinanceTransaction[]
  financeReports     FinanceReport[]

  @@index([status])
  @@index([accountType])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Content {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  slug        String        @unique
  body        String
  type        ContentType
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([type, status])
  @@index([publishedAt])
  @@map("contents")
}

model Agenda {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  description String
  location    String?
  startsAt    DateTime      @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([status, startsAt])
  @@map("agendas")
}

model Documentation {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  description String?
  mediaUrl    String        @map("media_url")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([status, createdAt])
  @@map("documentations")
}

model ProgramUpdate {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  author    User          @relation(fields: [authorId], references: [id])

  @@index([status, createdAt])
  @@map("program_updates")
}

model FinanceTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  authorId      String          @map("author_id") @db.Uuid
  type          TransactionType
  paymentMethod PaymentMethod   @map("payment_method")
  category      String
  description   String
  amount        Decimal         @db.Decimal(14, 2)
  occurredAt    DateTime        @map("occurred_at")
  evidenceUrl   String?         @map("evidence_url")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  author        User            @relation(fields: [authorId], references: [id])

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@map("finance_transactions")
}

model FinanceReport {
  id          String             @id @default(uuid()) @db.Uuid
  authorId    String             @map("author_id") @db.Uuid
  periodStart DateTime           @map("period_start")
  periodEnd   DateTime           @map("period_end")
  title       String
  summary     String?
  status      FinanceReportStatus @default(DRAFT)
  approvedAt  DateTime?          @map("approved_at")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  author      User                @relation(fields: [authorId], references: [id])

  @@index([status, periodStart, periodEnd])
  @@map("finance_reports")
}
