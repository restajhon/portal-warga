generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERASIONAL
}

enum AccountType {
  WARGA
  PENGURUS
}

enum UserStatus {
  MENUNGGU_VERIFIKASI
  AKTIF
  NONAKTIF
}

enum ContentType {
  BERITA
  PENGUMUMAN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum FinanceReportStatus {
  DRAFT
  MENUNGGU_APPROVAL
  DISETUJUI
  DIPUBLIKASIKAN
}

enum CitizenReportType {
  LAPORAN
  KELUHAN
  ASPIRASI
  BANTUAN
}

enum CitizenReportStatus {
  TERKIRIM
  DITINJAU
  DIPROSES
  SELESAI
  TIDAK_DAPAT_DIPROSES
}

enum SicknessReportStatus {
  TERKIRIM
  DITINJAU
  DIBANTU
  SELESAI
  TIDAK_DAPAT_DIPROSES
}

enum SicknessSeverity {
  RINGAN
  SEDANG
  BERAT
}

model User {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String
  email              String      @unique
  phone              String?     @unique
  passwordHash       String?     @map("password_hash")
  role               UserRole?
  accountType        AccountType @map("account_type")
  status             UserStatus  @default(MENUNGGU_VERIFIKASI)
  address            String?
  phoneVerifiedAt    DateTime?   @map("phone_verified_at")
  emailVerifiedAt    DateTime?   @map("email_verified_at")
  passwordSetAt      DateTime?   @map("password_set_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  contents           Content[]
  agendas            Agenda[]
  documents          Documentation[]
  programUpdates     ProgramUpdate[]
  transactions       FinanceTransaction[]
  financeReports     FinanceReport[]
  citizenReports     CitizenReport[]
  reportResponses    CitizenReportResponse[]
  sicknessReports        SicknessReport[]
  sicknessReportHelped   SicknessReportDetail[]
  sicknessResponses      SicknessReportResponse[]
  verifiedAccounts       User[]              @relation("VerifiedBy")
  verifiedBy             User?               @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById           String?             @db.Uuid @map("verified_by")

  @@index([status])
  @@index([accountType])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Content {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  slug        String        @unique
  body        String
  imageUrl    String?       @map("image_url")
  type        ContentType
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([type, status])
  @@index([publishedAt])
  @@map("contents")
}

model Agenda {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  description String
  imageUrl    String?       @map("image_url")
  location    String?
  startsAt    DateTime      @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([status, startsAt])
  @@map("agendas")
}

model Documentation {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  title       String
  description String?
  mediaUrl    String        @map("media_url")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])

  @@index([status, createdAt])
  @@map("documentations")
}

model ProgramUpdate {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  title     String
  body      String
  imageUrl  String?       @map("image_url")
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  author    User          @relation(fields: [authorId], references: [id])

  @@index([status, createdAt])
  @@map("program_updates")
}

model FinanceTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  authorId      String          @map("author_id") @db.Uuid
  type          TransactionType
  paymentMethod PaymentMethod   @map("payment_method")
  category      String
  description   String
  amount        Decimal         @db.Decimal(14, 2)
  occurredAt    DateTime        @map("occurred_at")
  evidenceUrl   String?         @map("evidence_url")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  author        User            @relation(fields: [authorId], references: [id])

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@map("finance_transactions")
}

model FinanceReport {
  id          String             @id @default(uuid()) @db.Uuid
  authorId    String             @map("author_id") @db.Uuid
  periodStart DateTime           @map("period_start")
  periodEnd   DateTime           @map("period_end")
  title       String
  summary     String?
  status      FinanceReportStatus @default(DRAFT)
  approvedAt  DateTime?          @map("approved_at")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  author      User                @relation(fields: [authorId], references: [id])

  @@index([status, periodStart, periodEnd])
  @@map("finance_reports")
}

model CitizenReport {
  id          String               @id @default(uuid()) @db.Uuid
  reporterId  String               @map("reporter_id") @db.Uuid
  type        CitizenReportType
  title       String
  body        String
  status      CitizenReportStatus  @default(TERKIRIM)
  resolvedAt  DateTime?            @map("resolved_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  reporter    User                 @relation(fields: [reporterId], references: [id])
  responses   CitizenReportResponse[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([type, status])
  @@map("citizen_reports")
}

model CitizenReportResponse {
  id              String        @id @default(uuid()) @db.Uuid
  reportId        String        @map("report_id") @db.Uuid
  responderId     String        @map("responder_id") @db.Uuid
  body            String
  statusAfter     CitizenReportStatus? @map("status_after")
  createdAt       DateTime      @default(now()) @map("created_at")
  report          CitizenReport @relation(fields: [reportId], references: [id])
  responder       User          @relation(fields: [responderId], references: [id])

  @@index([reportId, createdAt])
  @@index([responderId])
  @@map("citizen_report_responses")
}

/// Sickness report public metadata. Health details live in SicknessReportDetail
/// and are protected by field-level permission. See DECISIONS-BASELINE §5.
model SicknessReport {
  id              String                @id @default(uuid()) @db.Uuid
  reporterId      String                @map("reporter_id") @db.Uuid
  patientName     String                @map("patient_name")
  patientAddress  String?               @map("patient_address")
  patientRt       String?               @map("patient_rt")
  assistanceNeed  String                @map("assistance_need")
  severity        SicknessSeverity      @default(RINGAN)
  status          SicknessReportStatus  @default(TERKIRIM)
  resolvedAt      DateTime?             @map("resolved_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  reporter        User                  @relation(fields: [reporterId], references: [id])
  details         SicknessReportDetail[]
  responses       SicknessReportResponse[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([severity, status])
  @@map("sickness_reports")
}

/// Sensitive health details. Access requires `health:read` permission and is
/// recorded in audit log. Not exposed in list views, never returned to warga
/// other than the reporter.
model SicknessReportDetail {
  id             String         @id @default(uuid()) @db.Uuid
  reportId       String         @unique @map("report_id") @db.Uuid
  symptoms       String
  medicalNotes   String?        @map("medical_notes")
  contactPhone   String?        @map("contact_phone")
  helperId       String?        @map("helper_id") @db.Uuid
  helper         User?          @relation(fields: [helperId], references: [id])
  report         SicknessReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("sickness_report_details")
}

model SicknessReportResponse {
  id            String                  @id @default(uuid()) @db.Uuid
  reportId      String                  @map("report_id") @db.Uuid
  responderId   String                  @map("responder_id") @db.Uuid
  body          String
  statusAfter   SicknessReportStatus?   @map("status_after")
  createdAt     DateTime                @default(now()) @map("created_at")
  report        SicknessReport          @relation(fields: [reportId], references: [id])
  responder     User                    @relation(fields: [responderId], references: [id])

  @@index([reportId, createdAt])
  @@index([responderId])
  @@map("sickness_report_responses")
}
